generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  HOSPITAL
  LABORATORY
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum RecordType {
  CONSULTATION
  PRESCRIPTION
  LAB_REPORT
  ADMISSION
  DISCHARGE
  SURGERY
  VACCINATION
  DOCUMENT
}

enum BlockchainStatus {
  PENDING
  ANCHORED
  VERIFIED
  FAILED
  RETRYING
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PermissionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum TransactionType {
  RECORD
  ACCESS_GRANT
  ACCESS_REVOKE
  EMERGENCY_ACCESS
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum CareCaseStatus {
  SUBMITTED
  DOCTOR_ASSIGNED
  CONSENT_PENDING
  IN_CONSULTATION
  TESTS_ORDERED
  FOLLOW_UP
  COMPLETED
  CANCELLED
}

enum DiagnosticOrderStatus {
  REQUESTED
  LAB_ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum HospitalDoctorStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String   @id @default(cuid())
  fullName      String
  email         String   @unique
  passwordHash  String
  phone         String?
  role          Role
  walletAddress String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  patientProfile    PatientProfile?
  doctorProfile     DoctorProfile?
  hospitalProfile   HospitalProfile?
  laboratoryProfile LaboratoryProfile?
  createdRecords    MedicalRecord[]      @relation("RecordCreator")
  accessRequests    AccessRequest[]      @relation("AccessRequester")
  permissions       AccessPermission[]   @relation("AccessGrantee")
  emergencyLogs     EmergencyAccessLog[] @relation("EmergencyRequester")
  auditLogs         AuditLog[]           @relation("AuditActor")
  notifications     Notification[]
}

model PatientProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  healthId               String   @unique
  nidOrBirthCertificate  String
  dateOfBirth            DateTime
  gender                 String
  bloodGroup             String
  allergies              Json?
  chronicConditions      Json?
  currentMedications     Json?
  surgeryHistory         Json?
  vaccinationHistory     Json?
  emergencyContactName   String
  emergencyContactPhone  String
  address                String
  emergencyAccessEnabled Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  records       MedicalRecord[]
  prescriptions Prescription[]
  requests      AccessRequest[]
  permissions   AccessPermission[]
  emergencyLogs EmergencyAccessLog[]
  auditLogs     AuditLog[]
  careCases     CareCase[]

  @@index([healthId])
}

model CareCase {
  id                    String         @id @default(cuid())
  patientId             String
  problemTitle          String
  problemDetails        String         @db.Text
  preferredDoctorUserId String?
  hospitalUserId        String?
  assignedDoctorUserId  String?
  appointmentDate       DateTime
  status                CareCaseStatus @default(SUBMITTED)
  hospitalNotes         String?        @db.Text
  doctorNotes           String?        @db.Text
  followUpDate          DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  patient          PatientProfile    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  documents        CaseDocument[]
  diagnosticOrders DiagnosticOrder[]

  @@index([patientId, status])
  @@index([hospitalUserId, status])
  @@index([assignedDoctorUserId, status])
}

model CaseDocument {
  id               String   @id @default(cuid())
  careCaseId       String
  filePath         String
  originalFileName String
  mimeType         String
  fileSize         Int
  fileHash         String
  createdAt        DateTime @default(now())

  careCase CareCase @relation(fields: [careCaseId], references: [id], onDelete: Cascade)

  @@index([careCaseId])
}

model DiagnosticOrder {
  id                    String                @id @default(cuid())
  careCaseId            String
  patientId             String
  doctorUserId          String
  hospitalUserId        String?
  laboratoryUserId      String?
  testName              String
  clinicalReason        String                @db.Text
  instructions          String?               @db.Text
  status                DiagnosticOrderStatus @default(REQUESTED)
  reportMedicalRecordId String?
  orderedAt             DateTime              @default(now())
  assignedAt            DateTime?
  completedAt           DateTime?

  careCase CareCase @relation(fields: [careCaseId], references: [id], onDelete: Cascade)

  @@index([careCaseId, status])
  @@index([hospitalUserId, status])
  @@index([laboratoryUserId, status])
}

model HospitalDoctor {
  id             String               @id @default(cuid())
  hospitalUserId String
  doctorUserId   String
  status         HospitalDoctorStatus @default(PENDING)
  respondedAt    DateTime?
  createdAt      DateTime             @default(now())

  @@unique([hospitalUserId, doctorUserId])
  @@index([hospitalUserId])
  @@index([doctorUserId])
  @@index([doctorUserId, status])
}

model DoctorProfile {
  id                        String             @id @default(cuid())
  userId                    String             @unique
  medicalRegistrationNumber String             @unique
  specialization            String
  organizationName          String
  verificationStatus        VerificationStatus @default(PENDING)
  verifiedAt                DateTime?
  verifiedBy                String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  prescriptions Prescription[] @relation("DoctorPrescriptions")
}

model HospitalProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  hospitalName       String
  licenseNumber      String             @unique
  address            String
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  verifiedBy         String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LaboratoryProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  laboratoryName     String
  licenseNumber      String             @unique
  address            String
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  verifiedBy         String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MedicalRecord {
  id                    String           @id @default(cuid())
  patientId             String
  creatorUserId         String
  creatorOrganizationId String?
  recordType            RecordType
  title                 String
  description           String?          @db.Text
  recordDate            DateTime
  filePath              String?
  originalFileName      String?
  mimeType              String?
  fileSize              Int?
  fileHash              String
  metadataHash          String
  blockchainStatus      BlockchainStatus @default(PENDING)
  blockchainTxHash      String?
  blockchainBlockNumber Int?
  blockchainTimestamp   DateTime?
  blockchainError       String?          @db.Text
  isActive              Boolean          @default(true)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  patient      PatientProfile          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  creator      User                    @relation("RecordCreator", fields: [creatorUserId], references: [id])
  prescription Prescription?
  transactions BlockchainTransaction[]

  @@unique([fileHash])
  @@index([patientId, recordType])
  @@index([creatorUserId])
  @@index([blockchainStatus])
}

model Prescription {
  id              String    @id @default(cuid())
  medicalRecordId String    @unique
  patientId       String
  doctorId        String
  diagnosis       String
  notes           String?   @db.Text
  followUpDate    DateTime?
  createdAt       DateTime  @default(now())

  medicalRecord MedicalRecord            @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  patient       PatientProfile           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor        DoctorProfile            @relation("DoctorPrescriptions", fields: [doctorId], references: [id])
  medications   PrescriptionMedication[]
}

model PrescriptionMedication {
  id             String  @id @default(cuid())
  prescriptionId String
  medicineName   String
  dosage         String
  frequency      String
  duration       String
  instructions   String?

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}

model AccessRequest {
  id                     String              @id @default(cuid())
  patientId              String
  requesterUserId        String
  requesterRole          Role
  requestedCategories    Json
  reason                 String              @db.Text
  requestedDurationHours Int
  status                 AccessRequestStatus @default(PENDING)
  createdAt              DateTime            @default(now())
  reviewedAt             DateTime?

  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  requester User           @relation("AccessRequester", fields: [requesterUserId], references: [id])

  @@index([patientId, status])
  @@index([requesterUserId])
}

model AccessPermission {
  id                String           @id @default(cuid())
  patientId         String
  granteeUserId     String
  grantedCategories Json
  grantedAt         DateTime         @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  status            PermissionStatus @default(ACTIVE)
  permissionHash    String           @unique
  blockchainTxHash  String?
  blockchainStatus  BlockchainStatus @default(PENDING)

  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  grantee User           @relation("AccessGrantee", fields: [granteeUserId], references: [id])

  @@index([patientId, status])
  @@index([granteeUserId, status])
}

model EmergencyAccessLog {
  id                 String   @id @default(cuid())
  patientId          String
  requesterUserId    String
  reason             String   @db.Text
  accessedCategories Json
  blockchainTxHash   String?
  createdAt          DateTime @default(now())

  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  requester User           @relation("EmergencyRequester", fields: [requesterUserId], references: [id])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  patientId   String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  actor   User?           @relation("AuditActor", fields: [actorUserId], references: [id])
  patient PatientProfile? @relation(fields: [patientId], references: [id])

  @@index([actorUserId])
  @@index([patientId])
  @@index([action])
}

model Notification {
  id                String           @id @default(cuid())
  userId            String
  title             String
  message           String
  type              NotificationType @default(INFO)
  isRead            Boolean          @default(false)
  relatedEntityType String?
  relatedEntityId   String?
  createdAt         DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BlockchainTransaction {
  id              String            @id @default(cuid())
  recordId        String?
  transactionType TransactionType
  txHash          String?
  blockNumber     Int?
  network         String
  status          TransactionStatus @default(PENDING)
  errorMessage    String?           @db.Text
  createdAt       DateTime          @default(now())
  confirmedAt     DateTime?

  record MedicalRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)

  @@index([recordId])
  @@index([status])
}
